{
  "mcpServers": {
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": [
        "/home/abrar/code/story-engine"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/abrar/code/story-engine/.claude/hooks/check_services.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/abrar/code/story-engine/.claude/hooks/post_push_deploy.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
