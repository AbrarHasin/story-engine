      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SSE events fire per node, so the UI fills in\nas agents finish. nginx buffering is off and\nproxy timeouts are 300 s for slow local models.",
      "originalText": "SSE events fire per node, so the UI fills in\nas agents finish. nginx buffering is off and\nproxy timeouts are 300 s for slow local models.",
