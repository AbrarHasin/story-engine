      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "T4  topic and personality go straight into prompts, no output filter     T5  quick route and personality_injector are dead code (covered by #5)",
      "originalText": "T4  topic and personality go straight into prompts, no output filter     T5  quick route and personality_injector are dead code (covered by #5)",
