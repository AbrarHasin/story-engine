      "versionNonce": 772080596,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Five short calls on Haiku, two longer calls\non Sonnet. Hard max_tokens caps on every\nnode keep a story near $0.04 at the ceiling.",
      "originalText": "Five short calls on Haiku, two longer calls\non Sonnet. Hard max_tokens caps on every\nnode keep a story near $0.04 at the ceiling.",
