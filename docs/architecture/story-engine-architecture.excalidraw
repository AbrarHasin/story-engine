      "versionNonce": 804626222,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Five Haiku calls together cost less than one Sonnet output of 500 tokens.",
      "originalText": "Five Haiku calls together cost less than one Sonnet output of 500 tokens.",
      "fontSize": 13.5,
