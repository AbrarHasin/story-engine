      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The Project Hub quotes ~$0.19 per story and a ~$0.08 target. The code's caps give a",
      "originalText": "The Project Hub quotes ~$0.19 per story and a ~$0.08 target. The code's caps give a",
      "fontSize": 13.5,
