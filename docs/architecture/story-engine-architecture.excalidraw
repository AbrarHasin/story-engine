      "roundness": null,
      "seed": 2135167318,
      "version": 1,
      "versionNonce": 1866712956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The synthesizer re-reads the whole draft as input, so editing costs twice.",
      "originalText": "The synthesizer re-reads the whole draft as input, so editing costs twice.",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10,
      "autoResize": true
    },
    {
