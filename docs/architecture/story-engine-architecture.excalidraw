      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "T1  prod compose leaves LLM_PROVIDER=local     T2  no timeout or retry on model calls (roadmap wave 2)     T3  Redis checkpointer silently falls back to stateless",
      "originalText": "T1  prod compose leaves LLM_PROVIDER=local     T2  no timeout or retry on model calls (roadmap wave 2)     T3  Redis checkpointer silently falls back to stateless",
