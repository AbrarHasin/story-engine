      "versionNonce": 533915088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The writer's output is the single biggest line: close to 60% of the ceiling.",
      "originalText": "The writer's output is the single biggest line: close to 60% of the ceiling.",
      "fontSize": 13.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10,
      "autoResize": true
    },
    {
      "id": "text-0931",
      "type": "text",
      "x": 50,
      "y": 5800,
      "width": 563.44,
      "height": 16.88,
      "angle": 0,
      "strokeColor": "#414D5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
