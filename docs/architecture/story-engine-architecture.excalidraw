      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A Langfuse callback rides on every run.\nNo SaaS tracing bill, and trace ids are\nreturned in the final SSE event.",
      "originalText": "A Langfuse callback rides on every run.\nNo SaaS tracing bill, and trace ids are\nreturned in the final SSE event.",
