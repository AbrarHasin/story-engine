ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
LITELLM_BASE_URL=http://localhost:4000

# Langfuse — free OSS observability (replaces LangSmith)
# 1. Run: docker compose up -d langfuse
# 2. Visit http://localhost:3000 → sign up → Settings → API Keys
# 3. Paste keys below
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# SSLCommerz (Bangladesh Payment Gateway)
# Register at: https://join.sslcommerz.com
# Sandbox: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_pass
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_IPN_URL=https://storyteller.techvigilant.com/api/payment/ipn

# Database
DATABASE_URL=postgresql://storyengine:changeme@localhost:5432/storyengine

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH0_DOMAIN=your_domain.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret

# App
FRONTEND_URL=https://storyteller.techvigilant.com
BACKEND_CORS_ORIGINS=["https://storyteller.techvigilant.com","http://localhost:5173"]
