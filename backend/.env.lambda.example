# Environment of the Story Engine Lambdas (spec 002 Option S, ADR split-api-graph).
# Reference for infra/template.yaml. Two functions split by route at API Gateway:
#   story-api   (image target api,   RUN_ROLE=api)   every route except generation, buffered
#   story-graph (image target graph, RUN_ROLE=graph) POST /api/v1/stories/generate, streaming
# Values marked [api] / [graph] apply to that function only; the rest to both.
# Secrets are NOT Lambda env vars: they are SSM SecureString parameters under
# SSM_PARAMETER_PATH, loaded at cold start by app.core.ssm before Settings is validated
# (an env var with the same name wins, for local dev). Never commit real values.
# Dockerfile.lambda already bakes: DB_BACKEND=dataapi CHECKPOINTER=none TRUST_PROXY_HEADERS=true
#   APP_ENV=production AWS_LWA_PORT=8080 AWS_LWA_READINESS_CHECK_PATH=/health, and per target
#   api:   RUN_ROLE=api   AWS_LWA_INVOKE_MODE=buffered
#   graph: RUN_ROLE=graph AWS_LWA_INVOKE_MODE=response_stream EMBEDDING_BACKEND=fastembed
#          EMBEDDING_CACHE_DIR=/opt/models

# Aurora Serverless v2 over the RDS Data API
DATAAPI_RESOURCE_ARN=arn:aws:rds:us-east-1:<account>:cluster:<cluster-id>
DATAAPI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account>:secret:<name>
DATAAPI_DATABASE=storyengine
DATAAPI_RESUME_TIMEOUT_SECONDS=45     # [api] 20, under API Gateway's 29 s buffered limit

# Secrets: SecureStrings named <path><SETTING>. Comma-separated paths; IAM grants each
# function only its own, so story-api can never read the LLM key.
#   [api]   SSM_PARAMETER_PATH=/story-engine/prod/shared/
#   [graph] SSM_PARAMETER_PATH=/story-engine/prod/shared/,/story-engine/prod/graph/
#   shared/JWT_SECRET_KEY         (>= 32 chars)
#   shared/SSLCOMMERZ_STORE_ID
#   shared/SSLCOMMERZ_STORE_PASS
#   graph/ANTHROPIC_API_KEY
SSM_PARAMETER_PATH=/story-engine/prod/shared/,/story-engine/prod/graph/

# LLM (Anthropic API, no Bedrock). story-api only reports these on /api/v1/llm/config.
LLM_PROVIDER=anthropic

# Payments [api]
SSLCOMMERZ_SANDBOX=true

# Public URLs and CORS (BACKEND_CORS_ORIGINS is a JSON list, both functions)
FRONTEND_URL=https://storyteller.techvigilant.com
BACKEND_PUBLIC_URL=https://api.storyteller.techvigilant.com
BACKEND_CORS_ORIGINS=["https://storyteller.techvigilant.com"]

# Long runs [graph]: Lambda timeout 900 s > deadline 600 s; pings keep API Gateway's idle timer fed
RUN_DEADLINE_SECONDS=600
SSE_PING_SECONDS=15
STALE_RUNNING_MINUTES=15

# Semantic cache [graph] (ONNX MiniLM baked in the graph image only, loaded lazily)
SEMANTIC_CACHE_ENABLED=false

# Langfuse: leave both keys unset in production (tracing is local-only)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
