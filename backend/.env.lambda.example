# Environment of the Story Engine Lambda (spec 002 Option S). Reference for infra/template.yaml.
# Secrets come from SSM SecureString parameters at deploy time; never commit real values.
# Dockerfile.lambda already bakes: DB_BACKEND=dataapi CHECKPOINTER=none EMBEDDING_BACKEND=fastembed
#   EMBEDDING_CACHE_DIR=/opt/models TRUST_PROXY_HEADERS=true APP_ENV=production
#   AWS_LWA_INVOKE_MODE=response_stream AWS_LWA_PORT=8080 AWS_LWA_READINESS_CHECK_PATH=/health

# Aurora Serverless v2 over the RDS Data API
DATAAPI_RESOURCE_ARN=arn:aws:rds:us-east-1:<account>:cluster:<cluster-id>
DATAAPI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account>:secret:<name>
DATAAPI_DATABASE=storyengine
DATAAPI_RESUME_TIMEOUT_SECONDS=45

# LLM (Anthropic API, no Bedrock)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<from SSM>

# Auth / payments
JWT_SECRET_KEY=<from SSM, >= 32 chars>
SSLCOMMERZ_STORE_ID=<from SSM>
SSLCOMMERZ_STORE_PASS=<from SSM>
SSLCOMMERZ_SANDBOX=true

# Public URLs and CORS (BACKEND_CORS_ORIGINS is a JSON list)
FRONTEND_URL=https://storyteller.techvigilant.com
BACKEND_PUBLIC_URL=https://api.storyteller.techvigilant.com
BACKEND_CORS_ORIGINS=["https://storyteller.techvigilant.com"]

# Long runs: Lambda timeout 900 s > deadline 600 s; pings keep API Gateway's idle timer fed
RUN_DEADLINE_SECONDS=600
SSE_PING_SECONDS=15
STALE_RUNNING_MINUTES=15

# Semantic cache (ONNX MiniLM baked in the image, loaded lazily)
SEMANTIC_CACHE_ENABLED=false

# Langfuse: leave both keys unset in production (tracing is local-only)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
